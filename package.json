{
  "name": "smart-waste-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @smartwaste/api dev",
    "dev:web": "pnpm --filter @smartwaste/web dev",
    "dev:mobile": "pnpm --filter @smartwaste/mobile start",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @smartwaste/api run db:migrate",
    "db:generate": "pnpm --filter @smartwaste/api run db:generate",
    "db:seed": "pnpm --filter @smartwaste/api run db:seed"
  }
}
